#!/usr/bin/env node
// Medal's own folder sync lives in its recorder, which crashes under Wine.
// Watch the OBS replay folder and hand each finished clip to the running
// Medal app through its DevTools port (the launcher opens it on 127.0.0.1:9222),
// with the same MedalIPC.fileImport call that drag-and-drop uses.
import { spawn } from "node:child_process";
import { homedir } from "node:os";
import { join } from "node:path";

const DIR = process.env.OBS_DIR ?? join(homedir(), "Videos", "OBS");
const PORT = 9222;
const pending = new Set();

const toWinPath = f => "Z:" + join(DIR, f).replaceAll("/", "\\");
const log = (...a) => console.log(new Date().toTimeString().slice(0, 8), ...a);

async function importFiles(paths) {
  const list = await (await fetch(`http://127.0.0.1:${PORT}/json/list`)).json();
  const page = list.find(t => t.type === "page" && t.url.includes("renderer.min.html"));
  if (!page) throw new Error("Medal page not found");
  const expr = `MedalIPC.fileImport(${JSON.stringify(paths)}).then(r => r.length)`;
  return new Promise((resolve, reject) => {
    const ws = new WebSocket(page.webSocketDebuggerUrl);
    const timer = setTimeout(() => { ws.close(); reject(new Error("timeout")); }, 120000);
    ws.onerror = () => { clearTimeout(timer); reject(new Error("websocket error")); };
    ws.onopen = () => ws.send(JSON.stringify({
      id: 1, method: "Runtime.evaluate",
      params: { expression: expr, awaitPromise: true, returnByValue: true },
    }));
    ws.onmessage = m => {
      const msg = JSON.parse(m.data);
      if (msg.id !== 1) return;
      clearTimeout(timer);
      ws.close();
      if (msg.result?.exceptionDetails) reject(new Error(msg.result.exceptionDetails.exception?.description ?? "exception"));
      else resolve(msg.result?.result?.value);
    };
  });
}

async function flush() {
  if (!pending.size) return;
  const paths = [...pending];
  try {
    const n = await importFiles(paths);
    log(`imported ${n}/${paths.length}:`, paths.join(", "));
    paths.forEach(p => pending.delete(p));
  } catch (e) {
    log(`Medal not reachable (${e.message}), ${paths.length} clip(s) wait for the next try`);
  }
}

const watcher = spawn("inotifywait", ["-m", "-q", "-e", "close_write,moved_to", "--format", "%f", DIR]);
let buf = "";
watcher.stdout.on("data", d => {
  buf += d;
  const lines = buf.split("\n");
  buf = lines.pop();
  for (const f of lines) {
    if (!f.toLowerCase().endsWith(".mp4")) continue;
    log("new clip:", f);
    pending.add(toWinPath(f));
    setTimeout(flush, 2000);
  }
});
watcher.on("exit", code => { log("inotifywait exited", code); process.exit(1); });
setInterval(flush, 30000);
log("watching", DIR);
