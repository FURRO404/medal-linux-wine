#!/usr/bin/env python3
# Tray icon for Medal under Wine. Medal's own tray icon gets a 0x0 rect from
# Wine, so Medal drops it. This one starts Medal through the capped launcher,
# hides its window on start, and shows/hides it on click via KWin scripting.
import glob
import os
import subprocess
import sys
import tempfile

from PyQt6.QtCore import QTimer
from PyQt6.QtGui import QAction, QIcon
from PyQt6.QtWidgets import QApplication, QMenu, QSystemTrayIcon

LAUNCHER = os.path.expanduser("~/.local/bin/medal")
ICON = sorted(glob.glob(os.path.expanduser("~/.local/share/icons/hicolor/*/apps/*_Medal.0.png")))

KWIN_JS = """
for (const w of workspace.windowList()) {
  if (w.resourceClass != "medal.exe" || w.caption != "Medal") continue;
  const action = "%s";
  const hide = action == "hide" || (action == "toggle" && !w.minimized);
  w.minimized = hide;
  w.skipTaskbar = hide;
  w.skipSwitcher = hide;
  if (!hide) workspace.activeWindow = w;
}
"""


def medal_pids():
    out = subprocess.run(["pgrep", "-f", r"Medal[\\/]current[\\/]Medal\.exe"], capture_output=True, text=True)
    return [int(p) for p in out.stdout.split()]


def window_exists():
    out = subprocess.run(["xdotool", "search", "--class", "medal.exe"], capture_output=True, text=True)
    for wid in out.stdout.split():
        name = subprocess.run(["xdotool", "getwindowname", wid], capture_output=True, text=True).stdout
        if name.strip() == "Medal":
            return True
    return False


def kwin(action):
    with tempfile.NamedTemporaryFile("w", suffix=".js", delete=False) as f:
        f.write(KWIN_JS % action)
    name = "medal-tray-" + action
    try:
        subprocess.run(["qdbus6", "org.kde.KWin", "/Scripting", "org.kde.kwin.Scripting.unloadScript", name],
                       capture_output=True)
        sid = subprocess.run(["qdbus6", "org.kde.KWin", "/Scripting", "org.kde.kwin.Scripting.loadScript",
                              f.name, name], capture_output=True, text=True).stdout.strip()
        subprocess.run(["qdbus6", "org.kde.KWin", f"/Scripting/Script{sid}", "org.kde.kwin.Script.run"],
                       capture_output=True)
        subprocess.run(["qdbus6", "org.kde.KWin", "/Scripting", "org.kde.kwin.Scripting.unloadScript", name],
                       capture_output=True)
    finally:
        os.unlink(f.name)


class Tray:
    def __init__(self, app):
        self.icon = QSystemTrayIcon(QIcon(ICON[-1]) if ICON else QIcon.fromTheme("media-record"), app)
        self.icon.setToolTip("Medal")
        menu = QMenu()
        for label, fn in (("Show Medal", self.show), ("Hide Medal", lambda: kwin("hide")),
                          ("Quit Medal", self.quit_medal)):
            act = QAction(label, menu)
            act.triggered.connect(fn)
            menu.addAction(act)
        self.menu = menu
        self.icon.setContextMenu(menu)
        self.icon.activated.connect(self.clicked)
        self.icon.show()
        self.hide_tries = 0
        self.start(hidden=True)

    def start(self, hidden):
        if not medal_pids():
            subprocess.Popen([LAUNCHER], stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                             stderr=subprocess.DEVNULL, start_new_session=True)
        if hidden:
            self.hide_tries = 0
            QTimer.singleShot(2000, self.hide_when_ready)

    def hide_when_ready(self):
        # Wait for the main window; Medal shows it again once after its splash.
        if window_exists():
            kwin("hide")
            self.hide_tries += 1
            if self.hide_tries < 5:
                QTimer.singleShot(3000, self.hide_when_ready)
        elif self.hide_tries == 0:
            QTimer.singleShot(2000, self.hide_when_ready)

    def show(self):
        if medal_pids():
            kwin("show")
        else:
            self.start(hidden=False)

    def clicked(self, reason):
        if reason == QSystemTrayIcon.ActivationReason.Trigger:
            if medal_pids():
                kwin("toggle")
            else:
                self.start(hidden=False)

    def quit_medal(self):
        for pid in medal_pids():
            try:
                os.kill(pid, 15)
            except ProcessLookupError:
                pass


app = QApplication(sys.argv)
app.setQuitOnLastWindowClosed(False)
tray = Tray(app)
sys.exit(app.exec())
